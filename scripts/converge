#!/bin/bash
# Run the agent once on every node, in dependency order.
#
# The agent also runs as a service every 30 minutes (profile::openvox_agent);
# this is for when you do not want to wait. Bring-up leaves one known gap
# that this pass closes: the
# compiler enrols before the console exists, so it gets its bolt user (the
# console's key, collected from OpenVoxDB) only on a later run.
#
# The console runs before the compiler on purpose. A node uploads its facts
# at the start of a run, so the console's key fact reaches OpenVoxDB during
# the console's run — and the compiler's catalog can only see it after that.
#
#   ./scripts/converge              # all nodes
#   ./scripts/converge compiler01   # one node
set -uo pipefail
cd "$(dirname "$0")/.." || exit 1

nodes=("$@")
[ ${#nodes[@]} -gt 0 ] || nodes=(puppet console compiler01 agent01)

rc=0
for n in "${nodes[@]}"; do
  echo "==> $n"
  vagrant ssh "$n" -c 'sudo /opt/puppetlabs/bin/puppet agent -t --waitforlock 60' 2>/dev/null | tr -d '\r'
  code=${PIPESTATUS[0]}
  # 0 = no changes, 2 = changes applied; anything else is a failure.
  case $code in 0|2) ;; *) echo "!! $n exited $code"; rc=1 ;; esac
done
exit $rc
