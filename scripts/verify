#!/bin/bash
# Check that the estate is what the GUI's clustered mode expects, from the
# outside in: GUI health and login, cluster config and member health, fleet
# count against OpenVoxDB, Bolt from the console to every target, and the
# GUI's own cluster-preflight.
#
#   ./scripts/verify
set -uo pipefail
cd "$(dirname "$0")/.." || exit 1

PASS=0; FAIL=0
ok()  { echo "PASS  $*"; PASS=$((PASS+1)); }
bad() { echo "FAIL  $*"; FAIL=$((FAIL+1)); }
on()  { vagrant ssh "$1" -c "$2" 2>/dev/null | tr -d '\r'; }

ADMIN_PASSWORD=$(awk -F"'" '/^profile::console::admin_password:/ {print $2}' data/common.yaml)
GUI=https://localhost:4567

echo "== GUI"
health=$(on console "curl -skf $GUI/health")
[[ "$health" == *'"status":"ok"'* ]] && ok "/health: $health" || bad "/health: ${health:-no answer}"

token=$(on console "curl -sk -X POST $GUI/api/auth/login -H 'Content-Type: application/json' -d '{\"username\":\"admin\",\"password\":\"$ADMIN_PASSWORD\"}'" \
  | python3 -c 'import json,sys; print(json.load(sys.stdin).get("token",""))' 2>/dev/null)
[ -n "$token" ] && ok "admin login" || { bad "admin login"; }
auth="-H 'Authorization: Bearer $token'"

echo "== cluster"
cluster=$(on console "curl -sk $auth $GUI/api/config/cluster")
mode=$(printf '%s' "$cluster" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("deployment_mode",""))' 2>/dev/null)
[ "$mode" = clustered ] && ok "deployment_mode=clustered" || bad "deployment_mode=${mode:-?} ($cluster)"

chealth=$(on console "curl -sk $auth $GUI/api/config/cluster/health")
printf '%s\n' "$chealth" | python3 -c '
import json,sys
d=json.load(sys.stdin)
def walk(o,path=""):
    if isinstance(o,dict):
        if "fqdn" in o and ("ok" in o or "healthy" in o or "status" in o):
            st=o.get("ok",o.get("healthy",o.get("status")))
            print(("PASS  " if st in (True,"ok","healthy") else "FAIL  ")+path+" "+o["fqdn"]+" -> "+str(st))
        for k,v in o.items(): walk(v,path+"/"+k if isinstance(v,(dict,list)) else path)
    elif isinstance(o,list):
        for v in o: walk(v,path)
walk(d)' 2>/dev/null || bad "cluster/health unparseable: $chealth"

echo "== database"
# The GUI's own database: Postgres on the primary, provisioned by the
# installer, and what Settings > Cluster reports.
dburl=$(on console "sudo grep -E '^OPENVOX_GUI_DATABASE_URL=' /opt/openvox-gui/config/.env | sed 's/:[^:@]*@/:***@/'")
[[ "$dburl" == *"postgresql+asyncpg://openvox_gui:"*"@ovdb.example.com:5432/openvox_gui" ]] && ok "$dburl" || bad "DATABASE_URL: ${dburl:-unset}"
backend=$(printf '%s' "$cluster" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("database_backend",""))' 2>/dev/null)
[ "$backend" = postgresql ] && ok "cluster database_backend=postgresql" || bad "cluster database_backend=${backend:-?}"
tables=$(on puppet "sudo -u postgres psql -d openvox_gui -Atc \"select count(*) from pg_tables where schemaname='public' and tableowner='openvox_gui'\"")
[ "${tables:-0}" -gt 0 ] 2>/dev/null && ok "openvox_gui on the primary: $tables tables owned by openvox_gui" || bad "openvox_gui tables on the primary: ${tables:-none}"

echo "== fleet"
gui_nodes=$(on console "curl -sk $auth $GUI/api/nodes/" | python3 -c 'import json,sys; print(len(json.load(sys.stdin)))' 2>/dev/null)
pdb_nodes=$(on puppet "sudo curl -sk --cert /etc/puppetlabs/puppet/ssl/certs/puppet.example.com.pem --key /etc/puppetlabs/puppet/ssl/private_keys/puppet.example.com.pem --cacert /etc/puppetlabs/puppet/ssl/certs/ca.pem https://localhost:8081/pdb/query/v4/nodes" | python3 -c 'import json,sys; print(len(json.load(sys.stdin)))' 2>/dev/null)
if [ -n "$gui_nodes" ] && [ "$gui_nodes" = "$pdb_nodes" ]; then ok "GUI fleet ($gui_nodes) = OpenVoxDB /nodes ($pdb_nodes)"; else bad "GUI fleet (${gui_nodes:-?}) vs OpenVoxDB /nodes (${pdb_nodes:-?})"; fi

echo "== bolt"
# The per-console post-install step INSTALL.md prescribes (idempotent), then a
# run through the GUI's own API — the inventory, user, key and tmpdir it uses
# are the ones under test, not a hand-built bolt invocation.
on console "sudo /opt/openvox-gui/scripts/seed-bolt-known-hosts.sh >/dev/null 2>&1" || true
bolt=$(on console "curl -sk $auth -H 'Content-Type: application/json' -X POST $GUI/api/bolt/run/command -d '{\"command\":\"sudo -n true\",\"targets\":\"puppet.example.com,compiler01.example.com,agent01.example.com,console.example.com\"}'")
rc=$(printf '%s' "$bolt" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("returncode","?"))' 2>/dev/null)
if [ "$rc" = 0 ] && [[ "$bolt" == *"Successful on 4 targets"* ]]; then ok "GUI runs a privileged command on every target via Bolt"; else bad "GUI bolt run (rc=${rc:-?}): $(printf '%s' "$bolt" | cut -c1-300)"; fi

echo "== enc"
# The compiler must ask the console, and get the same answer the console
# gives directly. enc.py hides a failed request behind an empty
# classification, so its stderr is checked as well as its output.
conf=$(on compiler01 "sudo grep -E '^\s*(node_terminus|external_nodes)' /etc/puppetlabs/puppet/puppet.conf | tr -s ' \n' ' '")
[[ "$conf" == *"node_terminus = exec"* && "$conf" == *"external_nodes = /usr/local/bin/enc.py"* ]] && ok "compiler puppet.conf: $conf" || bad "compiler puppet.conf: ${conf:-no ENC settings}"
envfiles=$(on compiler01 "systemctl show -p EnvironmentFiles puppetserver")
[[ "$envfiles" == *"/etc/sysconfig/openvox-enc"* ]] && ok "puppetserver loads /etc/sysconfig/openvox-enc" || bad "puppetserver EnvironmentFiles: ${envfiles:-?}"
from_compiler=$(on compiler01 "sudo sh -c 'set -a; . /etc/sysconfig/openvox-enc; exec /usr/local/bin/enc.py agent01.example.com' 2>&1")
from_console=$(on console "curl -sk $GUI/api/enc/classify/agent01.example.com/yaml")
if [[ "$from_compiler" == *"ENC API"* || "$from_compiler" == *"Error"* ]]; then bad "enc.py on the compiler: $(printf '%s' "$from_compiler" | head -2 | tr '\n' ' ')"
elif [ -n "$from_compiler" ] && [ "$(printf '%s' "$from_compiler" | tr -d '[:space:]')" = "$(printf '%s' "$from_console" | tr -d '[:space:]')" ]; then ok "enc.py on the compiler answers what the console answers for agent01"
else bad "enc.py vs console for agent01: [$from_compiler] vs [$from_console]"; fi

# Settings > Cluster > Save seeds these; the lab drives that Save.
groups=$(on console "curl -sk $auth $GUI/api/enc/groups" | python3 -c 'import json,sys; print(" ".join(sorted(g["name"].replace(" ","_") for g in json.load(sys.stdin))))' 2>/dev/null)
[[ "$groups" == *OpenVox_Compiler* && "$groups" == *OpenVoxDB* ]] && ok "ENC infrastructure groups seeded: $groups" || bad "ENC infrastructure groups: ${groups:-none}"

echo "== preflight"
pre=$(on console "sudo /opt/openvox-gui/scripts/cluster-preflight.sh 2>&1 | tail -4")
[[ "$pre" == *"result: PASS"* || "$pre" == *"OK"* && "$pre" != *"FAIL"* ]] && ok "cluster-preflight" || bad "cluster-preflight: $pre"

echo
echo "$PASS passed, $FAIL failed"
[ "$FAIL" -eq 0 ]
